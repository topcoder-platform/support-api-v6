PORT=3000
SUPPORT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/topcoder?schema=support"

AUTH_SECRET="replace-with-a-local-development-secret"
VALID_ISSUERS='["https://api.topcoder-dev.com","https://topcoder-dev.auth0.com/","https://auth.topcoder-dev.com/"]'

TOPCODER_API_URL_BASE="https://api.topcoder-dev.com"
IDENTITY_API_URL="https://api.topcoder-dev.com/v6"
MEMBER_API_URL="https://api.topcoder-dev.com/v6/members"
SUPPORT_APP_BASE_URL="https://support.topcoder-dev.com"

AUTH0_URL="https://topcoder-dev.auth0.com/oauth/token"
AUTH0_AUDIENCE="https://api.topcoder-dev.com"
AUTH0_CLIENT_ID="replace-with-client-id"
AUTH0_CLIENT_SECRET="replace-with-client-secret"
AUTH0_PROXY_SERVER_URL=""
TOKEN_CACHE_TIME=86400
OUTBOUND_HTTP_TIMEOUT_MS=10000

# The wrapper appends /bus/events, so this value must be the v6 API base.
BUSAPI_URL="https://api.topcoder-dev.com/v6"
KAFKA_ERROR_TOPIC="common.error.reporting"
SENDGRID_SUPPORT_NEW_TICKET_TEMPLATE_ID=""
SENDGRID_SUPPORT_REPLY_TEMPLATE_ID=""
SENDGRID_SUPPORT_CLOSED_TEMPLATE_ID=""

SLACK_BOT_KEY=""
SLACK_CHANNEL_ID=""
ENV_NAME="DEV"

NOTIFICATION_POLL_INTERVAL_MS=30000
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_PROCESSING_TIMEOUT_MS=300000
